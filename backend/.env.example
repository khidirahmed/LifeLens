# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secret keys.
#
# All 3 values come from: Supabase Dashboard → Project Settings → API

# Your project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Service Role key — starts with sb_secret_ or eyJ...
# WARNING: bypasses Row Level Security. Server-side only. Never expose to clients.
SUPABASE_SECRET_KEY=your-service-role-key

# Anon / Publishable key — starts with sb_publishable_ or eyJ...
# Used for sign_in_with_password. Safe to use client-side.
SUPABASE_PUBLISH_KEY=your-anon-publishable-key
