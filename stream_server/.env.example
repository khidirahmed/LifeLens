# Copy to .env — relay_server.py loads stream_server/.env automatically.
# pip install -r requirements.txt  (includes python-dotenv)

LIFELENS_HOST=0.0.0.0
LIFELENS_PORT=9000

# Optional: IP shown for the phone/glasses app (default: auto-detected LAN). Same Wi-Fi as this Mac.
# LIFELENS_ADVERTISE_IP=10.0.0.5

# REQUIRED: real Tailscale IP of the machine running segment_receiver.py
# Wrong: http://100.x.x.x:8788/...  → causes "nodename nor servname" (Errno 8)
LIFELENS_SEND_SEGMENT_URL=http://YOUR_TAILSCALE_IP:8788/segment
LIFELENS_SEND_SEGMENT_META_URL=http://YOUR_TAILSCALE_IP:8788/meta
# LIFELENS_RECEIVER_WS=ws://YOUR_TAILSCALE_IP:8789

# Optional local copy on the Mac
# LIFELENS_SEGMENT_DIR=./recordings
