# Copy to .env and adjust. relay_server.py loads stream_server/.env automatically.
# pip install -r requirements.txt  (includes python-dotenv)

LIFELENS_HOST=0.0.0.0
LIFELENS_PORT=9000

# Optional: leave empty to disable
# LIFELENS_LATEST=latest.jpg
# LIFELENS_RECORD_DIR=

# Tailscale / segment receiver on ASUS (segment_receiver.py --port 8788)
LIFELENS_SEND_SEGMENT_URL=http://100.x.x.x:8788/segment
LIFELENS_SEND_SEGMENT_META_URL=http://100.x.x.x:8788/meta

# Optional local copy on the Mac while testing
# LIFELENS_SEGMENT_DIR=./recordings

# LIFELENS_SEGMENT_SECONDS=30
# LIFELENS_SEGMENT_FPS=24

# true / 1 / yes
# LIFELENS_NO_SEGMENTS=false
# LIFELENS_NO_DISPLAY=false
# LIFELENS_QUIET=false
