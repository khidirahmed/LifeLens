# Copy to .env — relay_server.py loads stream_server/.env automatically.
# pip install -r requirements.txt  (includes python-dotenv)

LIFELENS_HOST=0.0.0.0
LIFELENS_PORT=9000

# Optional: IP shown for the phone/glasses app (default: auto-detected LAN). Same Wi-Fi as this Mac.
# LIFELENS_ADVERTISE_IP=10.0.0.5

# REQUIRED: real Tailscale IP of the machine running segment_receiver.py
# Wrong: http://100.x.x.x:8788/...  → causes "nodename nor servname" (Errno 8)
LIFELENS_SEND_SEGMENT_URL=http://YOUR_TAILSCALE_IP:8788/segment
LIFELENS_SEND_SEGMENT_META_URL=http://YOUR_TAILSCALE_IP:8788/meta
# LIFELENS_RECEIVER_WS=ws://YOUR_TAILSCALE_IP:8789

# Optional local copy on the Mac
# LIFELENS_SEGMENT_DIR=./recordings

# ── analyze_video.py (run on ASUS / backend with segment_receiver) ───────────
# OpenAI-compatible HTTP API (OpenAI SDK) — pip install openai opencv-python-headless requests

# Optional: POST clip when a fall is detected (same shape as curl -F video=@clip.mp4).
# LIFELENS_ALERT_URL=http://192.168.x.x:3000/alert
# Optional Telegram (HTTPS API):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Voice call when a fall is detected (relay_server.py + LIFELENS_RECEIVER_WS) ─
# Set RETELL_API_KEY + RETELL_FROM_NUMBER (outbound call to RETELL_TO_NUMBER).
# analyze_video / segment_receiver only returns JSON; the Mac relay places the Retell call.
# Use a voice agent; dynamic vars include {{call_summary}}, {{alert_message}}, {{clip_name}}.
# https://docs.retellai.com/api-references/create-phone-call
#
# RETELL_API_KEY=key_...
# RETELL_FROM_NUMBER=+1XXXXXXXXXX   # must have an outbound voice agent in Retell (see below)
# RETELL_TO_NUMBER=+1XXXXXXXXXX     # who is called (E.164); optional default in code if unset
# RETELL_AGENT_ID=...               # required if Retell says "No outbound agent id set up for phone number"
#                                   # (paste a voice agent id from Retell, or bind agent to the number in UI)
# RETELL_DISABLE=1                  # optional; skip Retell calls (testing)
#
# Test call from project root:  python3 test_retell_call.py
# Inspect only:                 python3 test_retell_call.py --dry-run

# Required for analyze_video / analyze_clip:
#
# Example Alibaba DashScope (compatible mode — model id from their docs, not HF):
#   LIFELENS_VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LIFELENS_VLM_MODEL=qwen-vl-max  # or whatever DashScope lists for Qwen2.5-VL-72B
# Example local vLLM:
#   LIFELENS_VLM_BASE_URL=http://127.0.0.1:8000/v1
#
# LIFELENS_VLM_API_KEY=sk-...
# LIFELENS_VLM_BASE_URL=https://YOUR_HOST/v1
# Default in code: Qwen/Qwen2.5-VL-7B-Instruct (lighter for local GPU / HF).
# Even smaller: Qwen/Qwen2.5-VL-3B-Instruct. Larger: Qwen/Qwen2.5-VL-72B-Instruct
# HF router (optional): append :fastest / :cheapest / :providername
# LIFELENS_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# LIFELENS_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct:fastest
# How it works: the full segment is scanned at ~SAMPLE_FPS stills/sec; those stills are
# spread across the ENTIRE clip (not just the beginning), then at most MAX_FRAMES are kept.
# The model sees at most MAX_IMAGES_PER_REQUEST images per HTTP call; BATCH_OVERLAP repeats
# a few frames between calls so a fall sitting on a window edge appears in two requests.
# Defaults: SAMPLE_FPS=3, MAX_FRAMES=48, MAX_IMAGES_PER_REQUEST=8, BATCH_OVERLAP=2
# LIFELENS_VLM_SAMPLE_FPS=3.0
# LIFELENS_VLM_MAX_FRAMES=48
# If the API says "At most 4 image(s)", set LIFELENS_VLM_MAX_IMAGES_PER_REQUEST=4 (and optionally BATCH_OVERLAP=1).
# LIFELENS_VLM_MAX_IMAGES_PER_REQUEST=8
# LIFELENS_VLM_BATCH_OVERLAP=2
# LIFELENS_VLM_MAX_SIDE=768
# LIFELENS_VLM_JPEG_QUALITY=82
# LIFELENS_VLM_TIMEOUT_SEC=120
# LIFELENS_VLM_MAX_TOKENS=1024
# Optional batch folders (python analyze_video.py):
# LIFELENS_VIDEO_INPUT=/path/to/input
# LIFELENS_VIDEO_OUTPUT=/path/to/output
