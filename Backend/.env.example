# ── MongoDB ──────────────────────────────────────────────────────────
# Get your connection string from https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URL=mongodb+srv://youruser:yourpassword@cluster0.xxxxx.mongodb.net/lifelens?retryWrites=true&w=majority
MONGODB_DB_NAME=lifelens

# ── JWT ───────────────────────────────────────────────────────────────
# Generate a strong secret: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080   # 7 days

# ── Hex Storage ───────────────────────────────────────────────────────
HEX_API_KEY=your-hex-api-key
HEX_BASE_URL=https://api.hex.tech
HEX_BUCKET=lifelens-videos
